# Server
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173
# Comma-separated origins. Example for online backend + local V3 debugging:
# CORS_ORIGIN=https://www.example.com,http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGIN=http://localhost:5173
# In production, CORS_ORIGIN or FRONTEND_URL is required because credentials are enabled.
# In non-production, localhost/127.0.0.1/::1 origins are allowed unless CORS_ALLOW_LOCALHOST=false.
CORS_ALLOW_LOCALHOST=true
JWT_SECRET=replace-with-a-long-random-secret

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_CONNECT_TIMEOUT_MS=15000
DB_NAME=jack_house
DB_USER=root
DB_PASSWORD=

# Analytics
ANALYTICS_ENABLED=true
ANALYTICS_ENABLE_STATS=true
ANALYTICS_AUTO_MIGRATE=true
ANALYTICS_APPS=jack-house-v3
ANALYTICS_RETENTION_DAYS=14
# Defaults to the main DB settings when omitted.
# ANALYTICS_DB_HOST=127.0.0.1
# ANALYTICS_DB_NAME=jack_house
# ANALYTICS_DB_USER=root
# ANALYTICS_DB_PASSWORD=
ANALYTICS_DB_CONNECTION_LIMIT=5

# Historical MinIO read/delete compatibility and one-time migration sources.
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_POSTFILES_BUCKET=post-files
MINIO_BG_BUCKET=event-bg
# Legacy source used only by the one-time badge migration script.
MINIO_BADGES_BUCKET=badges

# GitHub storage: token stays on backend only.
# Owner/repo default to 1skyyks1/jack-house-img in code, but keep them explicit in production.
GITHUB_STORAGE_TOKEN=
GITHUB_STORAGE_OWNER=1skyyks1
GITHUB_STORAGE_REPO=jack-house-img
GITHUB_STORAGE_BRANCH=main
GITHUB_STORAGE_CDN=jsdelivr

# New rich text images upload publicly to PNGURL. Existing GitHub rows continue
# to resolve and clean up through their stored provider metadata.
RICHTEXT_UPLOAD_PROVIDER=pngurl
RICHTEXT_STORAGE_PROVIDER=github
RICHTEXT_STORAGE_BUCKET=rich-text
RICHTEXT_GITHUB_STORAGE_BASE_PATH=content
# Rich text cleanup is dry-run by default. Set false only for a scheduled trusted job.
RICHTEXT_ASSET_CLEANUP_RETENTION_DAYS=7
RICHTEXT_ASSET_CLEANUP_LIMIT=100
RICHTEXT_ASSET_CLEANUP_DRY_RUN=true
# One-time history backfill is also dry-run by default.
RICHTEXT_ASSET_BACKFILL_BATCH_SIZE=100
RICHTEXT_ASSET_BACKFILL_DRY_RUN=true

# New badge images upload publicly to PNGURL; existing GitHub images remain supported.
BADGES_UPLOAD_PROVIDER=pngurl
BADGES_STORAGE_PROVIDER=github
BADGES_STORAGE_BUCKET=badges
BADGES_GITHUB_STORAGE_BASE_PATH=content
# One-time MinIO -> GitHub migration is dry-run unless explicitly disabled.
BADGES_GITHUB_MIGRATION_DRY_RUN=true

# New event stage backgrounds upload publicly to PNGURL; existing GitHub images remain supported.
EVENT_STAGE_BG_UPLOAD_PROVIDER=pngurl
EVENT_STAGE_BG_STORAGE_PROVIDER=github
EVENT_STAGE_BG_STORAGE_BUCKET=event-stage-bg
EVENT_STAGE_BG_GITHUB_STORAGE_BASE_PATH=content
# One-time MinIO -> GitHub migration is dry-run unless explicitly disabled.
EVENT_STAGE_BG_GITHUB_MIGRATION_DRY_RUN=true
# Keep false by default so a partial migration requires an explicit decision.
EVENT_STAGE_BG_GITHUB_MIGRATION_ALLOW_MISSING=false

# Post submissions: no compression and no format conversion.
# Object name is short hash prefix + original extension; full sha256 is stored in DB.
POSTFILES_STORAGE_PROVIDER=github
POSTFILES_STORAGE_BUCKET=post-files
POSTFILES_GITHUB_STORAGE_BASE_PATH=submissions

# Upload limits
RICHTEXT_IMAGE_MAX_SIZE_MB=5
POSTFILE_MAX_SIZE_MB=20
POSTFILE_MAX_TOTAL_SIZE_MB=100
POSTFILE_ALLOWED_EXTENSIONS=.jpg,.jpeg,.png,.gif,.webp,.zip,.rar,.7z,.osz,.osk,.osr,.osu,.pdf,.txt,.md,.json,.csv,.xlsx,.xls
# POSTFILE_ALLOWED_MIME_TYPES=
EVENT_STAGE_BG_MAX_SIZE_MB=1

# PNGURL storage. Server-side rich-text, badge, and event-stage uploads omit
# strategy_id so PNGURL can automatically select an available storage strategy.
# Set a scope-specific override only when a stable strategy is required.
# PNG_URL_RICHTEXT_STRATEGY_ID=
# PNG_URL_BADGES_STRATEGY_ID=
# PNG_URL_EVENT_STAGE_BG_STRATEGY_ID=
# Reward images use a short-lived browser token and their own strategy setting.
PNG_URL_API_TOKEN=
PNG_URL_API_BASE_URL=https://pngurl.com/api/v1
PNG_URL_REQUEST_TIMEOUT_MS=60000
PNG_URL_REWARD_STRATEGY_ID=3
PNG_URL_TEMP_TOKEN_TTL_SECONDS=300

# Public image optimization. PNGURL uploads preserve their original format for
# content-review compatibility. This does not apply to post submissions.
IMAGE_OPTIMIZE_ENABLED=true
IMAGE_OPTIMIZE_CONVERT_WEBP=true
IMAGE_OPTIMIZE_MAX_WIDTH=2560
IMAGE_OPTIMIZE_MAX_HEIGHT=2560
IMAGE_OPTIMIZE_JPEG_QUALITY=82
IMAGE_OPTIMIZE_PNG_QUALITY=90
IMAGE_OPTIMIZE_WEBP_QUALITY=82

# Cookie auth migration
AUTH_COOKIE_NAME=jh_auth
CSRF_COOKIE_NAME=jh_csrf
AUTH_COOKIE_SAME_SITE=lax
# Set true in HTTPS production. Required when AUTH_COOKIE_SAME_SITE=none.
# If local V3 directly calls an online backend, the online backend must use
# AUTH_COOKIE_SAME_SITE=none and AUTH_COOKIE_SECURE=true, and CORS_ORIGIN must
# include http://localhost:5173 / http://127.0.0.1:5173.
AUTH_COOKIE_SECURE=false

# AI image generation via 65535. The API key must belong to an image-enabled group.
AI_IMAGE_API_BASE_URL=https://task-api-1-cn.65535.space
# Used only to query unfinished jobs created through the previous compatibility API.
AI_IMAGE_LEGACY_API_BASE_URL=https://img-cn.65535.space
AI_IMAGE_API_KEY=
AI_IMAGE_MODEL=gpt-image-2
# One active job per account is enforced in code. Keep the shared upstream cap below 5.
AI_IMAGE_GLOBAL_CONCURRENCY=4
AI_IMAGE_DAILY_LIMIT_USER=10
AI_IMAGE_DAILY_LIMIT_ORG=30
AI_IMAGE_QUOTA_TIMEZONE=Asia/Shanghai
# Native API tiers and ratios. The frontend also permits exact WIDTHxHEIGHT input.
AI_IMAGE_ALLOWED_SIZES=1k,2k,4k,auto,1:1,4:3,3:4,16:9,9:16
AI_IMAGE_MAX_PROMPT_LENGTH=8000
AI_IMAGE_MAX_FILE_SIZE_MB=20
AI_IMAGE_MAX_TOTAL_UPLOAD_MB=64
AI_IMAGE_UPSTREAM_TIMEOUT_MS=30000
AI_IMAGE_SYNC_INTERVAL_MS=3000
AI_IMAGE_STALE_CLEANUP_INTERVAL_MS=60000
AI_IMAGE_SYNC_ENABLED=true
